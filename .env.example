# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# MCP Server — API key for AI Agent access
MCP_API_KEY=YOUR_MCP_API_KEY_HERE

# Optional: set to true to show verbose error messages (not recommended in production)
VERBOSE_ERRORS=true

# Storage provider for uploaded media: local | minio | gcs
# - local: stores files under public/media (default)
# - minio: stores files in a MinIO bucket (S3-compatible)
# - gcs:   stores files in a Google Cloud Storage bucket
STORAGE_PROVIDER=local

# MinIO settings (only required when STORAGE_PROVIDER=minio)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=iec-media
MINIO_ACCESS_KEY_ID=YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_ACCESS_KEY=YOUR_MINIO_SECRET_KEY
# Optional, defaults to us-east-1. MinIO ignores region but the S3 SDK requires one.
MINIO_REGION=us-east-1

# Google Cloud Storage (only required when STORAGE_PROVIDER=gcs)
GCS_BUCKET=iec-media
# Optional — inferred from credentials if omitted
GCS_PROJECT_ID=your-gcp-project-id
# Choose ONE auth method:
#   1) GCS_KEY_FILE: absolute path to a service-account JSON key file (recommended for local dev)
#   2) GCS_CREDENTIALS: base64-encoded service-account JSON (recommended for Docker/Coolify;
#      raw JSON gets mangled by env-var layers). Generate with: base64 -w0 key.json
#   3) Leave both empty to use Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS, workload identity, etc.)
GCS_KEY_FILE=
GCS_CREDENTIALS=
