{
  "inputs": [
    {
      "id": "mcpApiKey",
      "type": "promptString",
      "description": "MCP_API_KEY (từ file .env)",
      "password": true
    }
  ],
  "servers": {
    "iec-cms": {
      "type": "http",
      "url": "http://localhost:3000/api/mcp",
      "headers": {
        "Authorization": "Bearer ${input:mcpApiKey}"
      }
    }
  }
}
